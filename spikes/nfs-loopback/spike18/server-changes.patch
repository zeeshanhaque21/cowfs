+use std::collections::HashMap;
+static LK_HIT: AtomicU64 = AtomicU64::new(0);
+static LK_MISS: AtomicU64 = AtomicU64::new(0);
+static NAMES: std::sync::OnceLock<std::sync::Mutex<HashMap<(u64, Vec<u8>), (u32, u32)>>> = std::sync::OnceLock::new();
+static IDS: std::sync::OnceLock<std::sync::Mutex<HashMap<(u32, u64), u64>>> = std::sync::OnceLock::new();
+
+pub fn enable_name_stats() {
+    let _ = NAMES.set(Default::default());
+    let _ = IDS.set(Default::default());
+}
+
+fn note_lookup(dir: u64, name: &[u8], hit: bool) {
+    (if hit { &LK_HIT } else { &LK_MISS }).fetch_add(1, Ordering::Relaxed);
+    if let Some(m) = NAMES.get() {
+        let mut m = m.lock().unwrap();
+        let e = m.entry((dir, name.to_vec())).or_default();
+        if hit { e.0 += 1 } else { e.1 += 1 }
+    }
+}
+
+fn note_id(proc_: u32, id: u64) {
+    if let Some(m) = IDS.get() {
+        *m.lock().unwrap().entry((proc_, id)).or_default() += 1;
+    }
+}
